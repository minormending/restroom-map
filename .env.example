# Leave these unset to run against the bundled Lower Manhattan seed data.
# Set them and the app switches to live Supabase reads with no code changes.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Basemap styles. CARTO's public vector styles need no API key and are fine at
# POC volume, but read their terms before you have real traffic. Swap in
# MapTiler / Stadia / Protomaps here when you outgrow them.
VITE_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
VITE_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Photon is built for autocomplete and is free without a key. Nominatim's
# public instance is NOT — it caps around 1 req/s and forbids this use.
VITE_GEOCODER_URL=https://photon.komoot.io/api/
