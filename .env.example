# Leave these unset to run against the bundled Lower Manhattan seed data.
# Set them and the app switches to live Supabase reads with no code changes.
#
# The database is shared with other apps: this one owns the `restroom` schema,
# over a `public` layer holding profiles, rate limiting and the moderation
# queue. The client sets db.schema; scripts get it from withClient. See
# trip-companion/docs/PLATFORM.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Basemap styles. CARTO's public vector styles need no API key and are fine at
# POC volume, but read their terms before you have real traffic. Swap in
# MapTiler / Stadia / Protomaps here when you outgrow them.
VITE_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
VITE_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Photon is built for autocomplete and is free without a key. Nominatim's
# public instance is NOT — it caps around 1 req/s and forbids this use.
VITE_GEOCODER_URL=https://photon.komoot.io/api/

# Admin access for scripts/db.mjs (migrations + ad-hoc SQL). Just the database
# password — host, port and user are derived from VITE_SUPABASE_URL above.
# This one IS a real secret, unlike the publishable key: it is full database
# access and bypasses RLS entirely. Never goes in the bundle; .env is gitignored.
SUPABASE_DB_PASSWORD=

# Only if the derived host is wrong, or you'd rather paste a full URL.
# SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
# SUPABASE_DB_URL=
